# ============================================================
# BACKEND — copy to backend/.env
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key       # never expose this to frontend
SUPABASE_ANON_KEY=your-anon-key

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173               # change for production
BACKEND_URL=http://localhost:3001                # change for production — used for webhook callbacks

# NOWPayments (crypto deposits & payouts — nowpayments.io)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret   # from NOWPayments dashboard → IPN settings

# Stripe (card deposits — stripe.com)
STRIPE_SECRET_KEY=sk_live_...                    # or sk_test_... for testing
STRIPE_WEBHOOK_SECRET=whsec_...                  # from Stripe Dashboard → Webhooks → signing secret


# ============================================================
# FRONTEND — copy to frontend/.env
# ============================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_API_URL=http://localhost:3001/api           # change for production
VITE_SOCKET_URL=http://localhost:3001            # change for production

VITE_PLATFORM_WALLET_ADDRESS=0xYourPlatformWalletAddress   # shown on deposit page

# Set to "true" to use Polygon Mumbai testnet, "false" for mainnet
VITE_USE_TESTNET=true
